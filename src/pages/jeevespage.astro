---
import FrontPageLayout from "../layouts/FrontPageLayout.astro";
import JeevesViewer from "../components/jeeves/JeevesViewer.svelte";
---

<FrontPageLayout title="Jeeves Archive">
  <div class="jeeves-page-container">
    <JeevesViewer client:load />
  </div>
</FrontPageLayout>

<style>
  .jeeves-page-container {
    width: 70%;
    max-width: 100%;
    margin: 0 auto;
    padding: 50px 0px;
  }

  /* Below 1200px the navbar becomes a floating hamburger in the top-right
     corner - start the page below it. */
  @media (max-width: 1199px) {
    .jeeves-page-container {
      padding-top: 68px;
    }
  }

  @media (max-width: 940px) {
    .jeeves-page-container {
      width: 90%;
    }
  }

  @media (max-width: 768px) {
    .jeeves-page-container {
      width: 100%;
      padding: 64px 0px 0px;
    }

    /* The reader starts flush at the top - its title row leaves room for
       the menu button itself (see JeevesPageStage). */
    :global(.jeeves-page-container:has(.reader)) {
      padding-top: 0;
    }
  }
</style>
