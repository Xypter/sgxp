---
import FrontPageLayout from "../layouts/FrontPageLayout.astro";
import ArchiveTriageTable from "../components/ArchiveTriageTable.svelte";
import { resolveUser } from "../lib/userCache";

// forceFresh: archivist access can be granted out-of-band (the Discord grant
// button PATCHes Payload directly, bypassing this site entirely), so the
// cached user snapshot can't be trusted to reflect it - always re-verify.
const { user } = await resolveUser(Astro.cookies, { forceFresh: true });

if (!user) {
  return Astro.redirect("/login");
}
---

<FrontPageLayout title="Smack Jeeves Archive Triage">
  <div class="triage-page">
    <ArchiveTriageTable user={user} client:only="svelte" />
  </div>
</FrontPageLayout>

<style>
  .triage-page {
    width: 100%;
    padding: 20px 1rem;
  }
</style>
