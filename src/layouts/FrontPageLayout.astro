---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/sprite_icon.css";

// Remove main.css import for now to avoid conflicts
// import "../styles/main.css";

// Correct import statement to the .tsx file
import SGXPNavbar from "../components/Navbar.svelte";
import ThemeBackdrop from "../components/ThemeBackdrop.astro";
import Toaster from "../lib/components/ui/layout/Toaster.svelte";

// Import types from the .tsx file
import ThemeValue from '../components/Navbar.svelte';
import User from '../components/Navbar.svelte';

import { resolveUser } from '../lib/userCache';
import { createHash } from 'node:crypto';
import { glyphStylesheet } from '../lib/spriteCardText';

// Sprite-card glyph classes (src/pages/sprite-glyphs.css.ts), versioned by content.
const glyphCssVersion = createHash('sha1').update(glyphStylesheet()).digest('hex').slice(0, 10);

// Get the theme from the cookie during SSR to prevent flashing
const themeFromCookie = (Astro.cookies.get('theme')?.value as ThemeValue) || "style_v7";
// "Motion: off" in the theme menu holds the theme scenery still (see ThemeBackdrop.astro).
const motionOff = Astro.cookies.get('motion')?.value === 'off';

// Assumes logged-in as long as payload-token is present; only round-trips to
// Payload when the display cache is missing/stale (see src/lib/userCache.ts).
const { user }: { user: User | null } = await resolveUser(Astro.cookies);

// Any other props for your layout
export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<!-- Set the data-theme attribute on the server based on the cookie -->
<html lang="en" class="dark" data-theme={themeFromCookie} data-motion={motionOff ? 'off' : undefined}>
<head>
  <script
    src="https://stats.sgxp.me:7443/api/script.js"
    data-site-id="1"
    defer
  ></script>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>

  <!-- Load consolidated themes CSS -->
  <link rel="stylesheet" type="text/css" href="/themes.css">
  <link rel="stylesheet" type="text/css" href={`/sprite-glyphs.css?v=${glyphCssVersion}`}>

  <!-- The theme loading script is no longer needed here as the theme is set on the server -->

  <link rel="icon" type="image/gif" href="/img/SGXPkanDos.gif" />
  <ClientRouter />
</head>
<body>
<!-- Theme scenery. Persisted so page navigations don't restart its animations;
     display: contents keeps the wrapper out of body's flex layout. -->
<div id="theme-backdrops" style="display: contents;" transition:persist>
  <ThemeBackdrop />
</div>
<!-- IMPORTANT: Using client:load to ensure navbar is interactive immediately on all pages -->
<SGXPNavbar client:load initialUser={user} baseURL={Astro.url.origin} initialTheme={themeFromCookie} initialMotionOff={motionOff} transition:persist />

  <div class="sonic-trigger" title="Click me!"></div>
  <!-- <script is:inline src="/js/arkanimation.js"></script> -->
  <slot>You're not supposed to see this LMAO</slot>

  <!-- OPTIMIZATION: Changed from client:load to client:idle to prevent blocking page load -->
  <Toaster client:idle />
</body>
</html>
