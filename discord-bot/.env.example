# Discord bot application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1468008691113660661
# Guild ID for fast/local slash command registration during development.
# Leave unset in production to register commands globally (slower to propagate).
DISCORD_DEV_GUILD_ID=

# Channel to post public things like the daily leaderboard
DISCORD_ANNOUNCE_CHANNEL_ID=

# Your Discord user ID, for direct-message notifications
DISCORD_OWNER_USER_ID=

# Birthday list: a single message you keep editing, one line per person,
# formatted like "<@userid> - August 27". Checked every 30 min so a missed
# run doesn't skip someone's birthday for the year.
BIRTHDAY_LIST_CHANNEL_ID=
BIRTHDAY_LIST_MESSAGE_ID=
# Channel the birthday ping actually gets posted to (e.g. #general)
BIRTHDAY_ANNOUNCE_CHANNEL_ID=

# Payload CMS API this bot reads from (same instance the website uses)
PAYLOAD_URL=

# Shared secret the website's webhook forwarder must present when calling
# this bot's /events endpoint. Generate with: openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Port the bot's internal HTTP server listens on for site-triggered events.
# Coolify may inject its own PORT (commonly 3000) that overrides this default
# — check the bot's startup log ("[events] listening on :XXXX") and make sure
# the app's exposed port setting in Coolify matches whatever it actually binds to.
PORT=3100
