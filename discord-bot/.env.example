# Discord bot application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1468008691113660661
# Guild ID for fast/local slash command registration during development.
# Leave unset in production to register commands globally (slower to propagate).
DISCORD_DEV_GUILD_ID=

# Channel to post public things like daily leaderboard / birthdays
DISCORD_ANNOUNCE_CHANNEL_ID=

# Your Discord user ID, for direct-message notifications
DISCORD_OWNER_USER_ID=

# Payload CMS API this bot reads from (same instance the website uses)
PAYLOAD_URL=

# Shared secret the website's webhook forwarder must present when calling
# this bot's /events endpoint. Generate with: openssl rand -hex 32
BOT_WEBHOOK_SECRET=

# Port the bot's internal HTTP server listens on for site-triggered events
PORT=3100
